---
import StatusBadge from './StatusBadge.astro';
import Legend from './Legend.astro';
import { quarters, areas } from '../data/roadmap';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Legend lang={lang} />
<ol class="roadmap">
  {quarters.map((q) => (
    <li class={`roadmap__item roadmap__item--${q.status}`}>
      <h2>
        <span class="muted">{q.when[lang]} · {t.target}</span>
        {' '}{q.title[lang]}
      </h2>
      <p>{q.goal[lang]}</p>
      {areas.filter((a) => a.quarter === q.id).map((a) => {
        const done = a.features.filter((x) => x.status === 'available').length;
        return (
          <section class="area" aria-label={a.title[lang]}>
            <h3>{a.title[lang]} <StatusBadge lang={lang} status={a.status} /></h3>
            <p>{a.goal[lang]}</p>
            {a.features.length > 0 && (
              <details>
                <summary>{t.progress(done, a.features.length)}</summary>
                <ul class="features">
                  {a.features.map((x) => <li><StatusBadge lang={lang} status={x.status} /> <span>{x.title[lang]}</span></li>)}
                </ul>
              </details>
            )}
          </section>
        );
      })}
    </li>
  ))}
</ol>
