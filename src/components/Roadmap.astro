---
import StatusBadge from './StatusBadge.astro';
import Legend from './Legend.astro';
import { phases } from '../data/roadmap';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Legend lang={lang} />
<ol class="roadmap">
  {phases.map((p) => {
    const done = p.features.filter((x) => x.status === 'available').length;
    return (
      <li class={`roadmap__item roadmap__item--${p.status}`}>
        <h2>
          <span class="muted">{/^\d+$/.test(p.id) ? `${t.phase} ${p.id}` : p.id.replace('S', lang === 'uk' ? 'Етап ' : 'Stage ')}</span>
          {' '}{p.title[lang]} <StatusBadge lang={lang} status={p.status} />
        </h2>
        <p>{p.goal[lang]}</p>
        {p.features.length > 0 && (
          <details>
            <summary>{t.progress(done, p.features.length)}</summary>
            <ul class="features">
              {p.features.map((x) => <li><StatusBadge lang={lang} status={x.status} /> <span>{x.title[lang]}</span></li>)}
            </ul>
          </details>
        )}
      </li>
    );
  })}
</ol>
