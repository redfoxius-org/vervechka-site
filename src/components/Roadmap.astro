---
import { quarters, areas, portalPercent } from '../data/roadmap';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="readiness" aria-label={t.portalReady}>
  <p><strong>{t.portalReady} {portalPercent}%</strong></p>
  <progress max="100" value={portalPercent} aria-label={`${t.portalReady} ${portalPercent}%`}></progress>
  <p class="muted">{t.readyMethod}</p>
</section>
<ol class="roadmap">
  {quarters.map((q) => (
    <li class="roadmap__item">
      <h2>
        <span class="muted">{q.when[lang]} · {t.target}</span>
        {' '}{q.title[lang]}
      </h2>
      <p>{q.goal[lang]}</p>
      {areas.filter((a) => a.quarter === q.id).map((a) => (
        <section class="area" aria-label={a.title[lang]}>
          <h3>{a.title[lang]}</h3>
          <p>{a.goal[lang]}</p>
          <ul class="features">
            {a.features.map((x) => <li>{x[lang]}</li>)}
          </ul>
        </section>
      ))}
    </li>
  ))}
</ol>
