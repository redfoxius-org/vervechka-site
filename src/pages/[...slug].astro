---
// Ukrainian pages (default locale, no URL prefix).
import { getCollection } from 'astro:content';
import PageView from '../components/PageView.astro';

export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => e.data.lang === 'uk');
  return entries.map((entry) => ({ params: { slug: entry.data.page || undefined }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PageView entry={entry} />
